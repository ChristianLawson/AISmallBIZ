      {"@context":"https://schema.org","@type":"Article","headline":"AISmallBiz: Teach Your Specialty Online","description":"Teach your specialty online and turn what you know into lessons people love. A practical guide to pricing, platforms, and the connection students come back for.","author":{"@type":"Organization","name":"AISmallBiz","url":"https://www.aismallbiz.org"},"publisher":{"@type":"Organization","name":"AISmallBiz","url":"https://www.aismallbiz.org","logo":{"@type":"ImageObject","url":"https://www.aismallbiz.org/assets/generated/social-card.png"}},"datePublished":"2026-07-15","dateModified":"2026-07-15","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.aismallbiz.org/online-schooling"}}
